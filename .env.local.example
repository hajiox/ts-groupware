# Supabase（内職管理プロジェクトに同居）
NEXT_PUBLIC_SUPABASE_URL="https://zfhswguzqyagmhhlpksq.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="（内職管理と同じanon key）"
SUPABASE_SERVICE_ROLE_KEY="（内職管理と同じservice_role key）"

# LINE OAuth（内職管理と同じチャネルを共用）
LINE_CHANNEL_ID="（内職管理と同じLINE_CHANNEL_ID）"
LINE_CHANNEL_SECRET="（内職管理と同じLINE_CHANNEL_SECRET）"

# サイトURL
NEXT_PUBLIC_SITE_URL="https://ts-groupware.vercel.app"

# Web Push（新規VAPID鍵 — 別途生成必要）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Google Drive（ファイルストレージ用 — Phase後半で設定）
# OAuth方式（マイドライブ内フォルダに保存する場合）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# Gmail送信（勤怠の労務士提出メール用）
# OAuth方式では gmail.send スコープ付きrefresh tokenを設定
GOOGLE_GMAIL_REFRESH_TOKEN=""

# Google Calendar（aizubrandhall@gmail.com 予定取込用）
# OAuth方式では calendar.readonly スコープ付きrefresh tokenを設定
GOOGLE_CALENDAR_ID="aizubrandhall@gmail.com"
GOOGLE_CALENDAR_REFRESH_TOKEN=""
# 未設定時は自動同期ON。同じ表示期間のGoogle再取得を何分スキップするか。
TSG_GOOGLE_CALENDAR_AUTO_SYNC="true"
TSG_GOOGLE_CALENDAR_AUTO_SYNC_MINUTES="10"
# 取り込んだGoogle予定のTSG上の作成者を固定したい場合のみ指定。未設定時はTSG君→管理者→閲覧者の順で自動選択。
TSG_CALENDAR_IMPORT_USER_ID=""

# サービスアカウント方式（共有ドライブ配下フォルダが必要）
# Calendarを読む場合は、対象カレンダーをサービスアカウントのclient_emailへ共有する
# GOOGLE_SERVICE_ACCOUNT_KEY=""

# 勤怠打刻（個人スマホ打刻を使う場合の勤務先Wi-Fi判定。主方式は専用端末）
# 勤務先Wi-Fi経由で外部に出るグローバルIPをカンマ区切りで設定。CIDRも可。
# 例: TSG_ATTENDANCE_ALLOWED_IPS="203.0.113.10,198.51.100.0/24"
TSG_ATTENDANCE_ALLOWED_IPS=""
# 接続元ラベルを残したい場合。例: TSG_ATTENDANCE_ALLOWED_NETWORKS="TS社内=203.0.113.10,道の駅=198.51.100.25"
TSG_ATTENDANCE_ALLOWED_NETWORKS=""
# 給与閲覧/給与管理を許可する本名。未設定時は 佐藤正彦,佐藤ちさと。
TSG_PAYROLL_MANAGER_NAMES="佐藤正彦,佐藤ちさと"
